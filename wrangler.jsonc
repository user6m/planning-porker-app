{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "planning-porker-app",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-05",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		// 静的アセットは `pnpm build` (vite build) が dist/ に出力する
		// (src/client → app.js / theme.js、public/style.css はそのままコピー)。
		// dist/ が存在しないと wrangler dev / wrangler deploy は起動時にエラーになるので先にビルドすること
		// (package.json の dev / deploy スクリプトと CI が自動で行う)。
		"directory": "./dist"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "POKER_ROOM",
				"class_name": "PokerRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PokerRoom"]
		}
	]
	// SESSION_SECRET is NOT declared here. In production it's set with
	// `wrangler secret put SESSION_SECRET` (see README). Locally, put it in
	// a git-ignored `.dev.vars` file instead — a `vars` entry here would be
	// committed in plaintext and would silently overwrite the real secret
	// on every `wrangler deploy`.
}
