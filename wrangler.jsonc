{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "planning-porker-app",
	"main": "src/worker/index.ts",
	"compatibility_date": "2025-09-05",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		// 静的アセット(React SPA)の出力先 `dist/client` は @cloudflare/vite-plugin が
		// ビルド時に生成する dist/planning_porker_app/wrangler.json へ自動で書き込むので、
		// ここでは `directory` を指定しない。
		//
		// - not_found_handling: どのアセットにも一致しないパス(/rooms/XXXX など)は
		//   index.html を返し、React Router 側でルーティングする (SPAモード)
		// - run_worker_first: `/api/*` だけは常に Worker (src/worker/index.ts) で処理する。
		//   それ以外のリクエストは Worker を起動せずにアセットとして配信される
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "POKER_ROOM",
				"class_name": "PokerRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PokerRoom"]
		}
	]
	// SESSION_SECRET is NOT declared here. In production it's set with
	// `wrangler secret put SESSION_SECRET` (see README). Locally, put it in
	// a git-ignored `.dev.vars` file instead — a `vars` entry here would be
	// committed in plaintext and would silently overwrite the real secret
	// on every `wrangler deploy`.
}
