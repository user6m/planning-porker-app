{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"lib": ["ES2022"],
		// `Env` などの Workers ランタイム型は `pnpm cf-typegen` が生成する worker-configuration.d.ts から、
		// `cloudflare:test` モジュールの型は @cloudflare/vitest-pool-workers から取り込む
		"types": ["@cloudflare/vitest-pool-workers"]
	},
	"include": ["src/worker", "src/shared", "test", "worker-configuration.d.ts"]
}
