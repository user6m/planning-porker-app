{
	"name": "planning-porker-app",
	"version": "0.1.0",
	"private": true,
	"description": "複数人でリアルタイムに見積もりを行えるプランニングポーカーアプリ",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check",
		"fix": "biome check --write",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"hono": "^4.13.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@types/node": "^26.4.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0",
		"wrangler": "^4.129.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.29.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
