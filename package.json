{
	"name": "planning-porker-app",
	"version": "2026.10.0",
	"private": true,
	"description": "複数人でリアルタイムに見積もりを行えるプランニングポーカーアプリ",
	"type": "module",
	"scripts": {
		"dev": "vite build && concurrently -k -n vite,wrangler \"vite build --watch --clearScreen false\" \"wrangler dev\"",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy --minify",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check",
		"fix": "biome check --write",
		"cf-typegen": "wrangler types",
		"version:bump": "node scripts/bump-calver.mjs"
	},
	"dependencies": {
		"hono": "^4.13.13",
		"qrcode-generator": "^2.0.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@types/node": "^26.6.4",
		"concurrently": "^10.0.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.29.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
